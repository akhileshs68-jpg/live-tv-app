    "creators": {
      "title": "Creator Profiles",
      "description": "Verified creator metadata and channel profiles",
      "type": "object",
      "properties": {
        "piUserId": { "type": "string" },
        "username": { "type": "string" },
        "displayName": { "type": "string" },
        "channelName": { "type": "string" },
