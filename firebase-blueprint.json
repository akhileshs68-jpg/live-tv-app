        "dailyCoinsEarned": { "type": "number" },
        "dailyResetDate": { "type": "string" },
        "lastHeartbeatAt": { "type": "number" },
        "premium": { "type": "object", "description": "Server-authoritative Premium Pioneer entitlement status" },
        "updatedAt": { "type": "string" }
      },
      "required": ["piUserId", "totalCoins"]
    },
